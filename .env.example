# Скопируйте в .env и заполните значения.
# Файл .env не коммитится (.gitignore).

SECRET_KEY=
ADMIN_PASSWORD=
DATABASE=

# Токен для POST /internal/deploy (GitHub Actions → PythonAnywhere).
# Оставьте пустым, чтобы отключить endpoint.
DEPLOY_SECRET=

# 1 на HTTPS (production); 0 или пусто для локального http://
SESSION_COOKIE_SECURE=0

# TTL permanent-сессии (не Flask-дефолт ~31 день).
PERMANENT_SESSION_LIFETIME=14
